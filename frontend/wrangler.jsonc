{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ai1sad",
  "compatibility_date": "2026-10-02",
  "routes": [
    { "pattern": "ai1sad.org", "custom_domain": true },
    { "pattern": "www.ai1sad.org", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
