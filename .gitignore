__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.venv/
venv/
.env

# Original source files are preserved locally but can include victim names,
# source notes, URLs, and other details unsuitable for public publishing.
data/raw/*
!data/raw/README.md
data/raw/external/
data/processed/
reports/*.json
reports/*.csv
reports/*.html

# Local/manual GSAF intake files and generated audit outputs stay private.
data/imports/gsaf/raw/*
!data/imports/gsaf/raw/.gitkeep
data/imports/gsaf/staging/*
!data/imports/gsaf/staging/.gitkeep
data/imports/gsaf/reports/*
!data/imports/gsaf/reports/.gitkeep

# Local/manual archival source metadata and generated audit outputs stay private.
data/imports/archival_news/raw/*
!data/imports/archival_news/raw/.gitkeep
!data/imports/archival_news/raw/archival_sources_template.csv
data/imports/archival_news/staging/*
!data/imports/archival_news/staging/.gitkeep
data/imports/archival_news/reports/*
!data/imports/archival_news/reports/.gitkeep

# Local Sharks Happen source workbooks and generated comparison outputs stay private.
data/imports/sharks_happen/raw/*
!data/imports/sharks_happen/raw/.gitkeep
data/imports/sharks_happen/staging/*
!data/imports/sharks_happen/staging/.gitkeep
data/imports/sharks_happen/reports/*
!data/imports/sharks_happen/reports/.gitkeep

# Generated public artifacts can be rebuilt from raw data.
data/public/*.csv
data/public/*.sqlite
data/public/*.db
data/public/schema.json
data/public/incident_globe_*.json

# Hidden, sensitive, restricted, or license-unclear data must stay local.
data/private/
data/media_attachments/

# Frontend local dependencies and generated build output.
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/coverage/
frontend/*.tsbuildinfo

# Local editor and demo-server scratch files.
.vscode/
*.code-workspace
.mkdocs-demo.*

# MkDocs generated GitHub Pages output.
site/
